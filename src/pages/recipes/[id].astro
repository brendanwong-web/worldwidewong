---
import { getCollection } from "astro:content";
import { getAlbumImages } from '@/lib/data-utils'
import { Image } from "astro:assets";
import Callout from '@/components/Callout.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { getEntry, render } from 'astro:content';
import IngList from "@/components/IngList.astro";
import PageHead from '@/components/PageHead.astro'
import Link from '@/components/Link.astro'
import PostHead from '@/components/PostHead.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import SubpostsHeader from '@/components/SubpostsHeader.astro'
import SubpostsSidebar from '@/components/SubpostsSidebar.astro'
import TOCHeader from '@/components/TOCHeader.astro'
import TOCSidebar from '@/components/TOCSidebar.astro'
import { badgeVariants } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import Layout from '@/layouts/Layout.astro'
import Recipe from '@/components/Recipe.astro'
import { formatDate } from '@/lib/utils'

export async function getStaticPaths() {
    const recipes = await getCollection("recipes");
  
    const paths = Object.values(recipes).map((recipe) => {
        return {
        params: {id: recipe.id},
        props: {recipe}
        };
    });

    return paths;
}


const { id } = Astro.params;
const { recipe } = Astro.props;

const { Content, headings } = await render(recipe);

const ingGroups = recipe.data.ingredients
// const isSingle = recipe.data.ingredients.length == 1 ? true : false
---

<Layout class="max-w-3xl">
    <PageHead slot="head" title="Recipes" />
    <Breadcrumbs items={[
        { href: '/recipes', label: 'Recipes', icon: 'lucide:cooking-pot' },
        { label: recipe.id, icon: 'lucide:eye' },
        ]} />
  
    <section>
      <div class="prose">
        <div class="flex flex-col mb-8 md:flex-row md:h-64 bg-secondary border border-muted-foreground/60">
            <div class="recipe-text basis-2/3 p-4 order-1 md:order-none">

                <h3 class="text-4xl mt-0 mb-2 lg:mt-4 leading-none font-medium font-recipe">{recipe.data.title}</h3>
                <p class="text-sm text-primary/50 mt-0">
                    {formatDate(recipe.data.pubDate)}
                </p>
                <p class="text-xl mb-0">
                    {recipe.data.description}
                </p>
            </div>
            {
                recipe.data.cover && (
                  <div class="h-64 md:basis-1/3">
                    <Image
                        src={recipe.data.cover}
                        alt={recipe.data.coverAlt}
                        width="1280"
                        class:list={[
                          "object-cover md:w-full h-full m-0 object-center border-b md:border-b-0 md:border-l border-muted-foreground/60",
                          "group-hover:shadow-lg group-hover:opacity-90"
                        ]}
                      />
                  </div>
                )
              }
            

        </div>
        <Recipe>
            <Fragment slot="ing">
                {   
                    ingGroups.map((ingList) => {
                        return(

                            <IngList title={ingList.subtitle} ing={ingList.ingList} isSingle={false}/>
                        )
                    })
                }
               <!--  <ul>
                    {
                        recipe.data.ingredients &&
                        recipe.data.ingredients.length > 0 &&
                        recipe.data.ingredients.map((ing) => {
                            return(
                                <li>
                                    {ing}
                                </li>
                            )
                        })
                    }
                </ul> -->
            </Fragment>
            <Fragment slot="steps">
          
                <Content />
            </Fragment>
          </Recipe> 
        

      </div>
    </section>
</Layout>
