---
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { cva, type VariantProps } from 'class-variance-authority'

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

interface Props {
  title: string;
  isSingle: boolean;
  ing?: Array<string>;
}

const { title, ing, isSingle } = Astro.props
---

<section class="text-pretty text-neutral-700">
  <div>
    <h3>
      {
        !isSingle &&
        title
      }
    </h3>
    <ul>
      {
        ing?.map((k) => {
            return(
              <li>
          {k}
        </li>
            )
      })
    }
    </ul>
  </div>
</section>
