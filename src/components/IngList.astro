---
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { cva, type VariantProps } from 'class-variance-authority'

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

interface Props {
  title: string;
  isSingle: boolean;
  ing?: Array<string>;
}

const { title, ing, isSingle } = Astro.props

---

  <div>
    <h3 class="capitalize text-sm m-0">
      {
        !isSingle &&
        title
      }
    </h3>
    <ul class="my-0">
      {
        ing?.map((k) => {
            return(
              <li class="capitalize">
                {k}
              </li>
            )
      })
    }
    </ul>
  </div>
